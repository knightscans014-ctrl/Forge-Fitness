# FORGE environment variables (copy to .env / set in EAS)
# NEVER commit real keys. Public keys (EXPO_PUBLIC) are safe to embed.

# --- Supabase Auth (email + Google) ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Payments: receive via your Fampay UPI ID / QR ---
# Set this to your actual Fampay UPI ID (e.g. "yourname@fam").
EXPO_PUBLIC_FAMPAY_UPI_ID=yourname@fam

# --- Optional: Google OAuth (configured in Supabase dashboard) ---
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
