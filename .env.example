# FORGE environment variables (copy to .env / set in EAS)
# NEVER commit real keys. Public keys (NEXT_PUBLIC/EXPO_PUBLIC) are safe to embed.

# --- Supabase Auth ---
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Razorpay (UPI payments) ---
# Server-side only (never ship the secret):
RAZORPAY_KEY_ID=rzp_live_yourkeyid
RAZORPAY_KEY_SECRET=your_secret

# Public key used to open the checkout:
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_live_yourkeyid

# --- Optional: Google OAuth (configured in Supabase dashboard) ---
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
