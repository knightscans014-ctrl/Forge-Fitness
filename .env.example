# Copy to .env and fill in. NEVER commit the real .env.
#
# Everything prefixed EXPO_PUBLIC_ is embedded in the built app and is
# readable by anyone who unzips the APK. Only put values here that are safe
# to be public. Real secrets belong in Supabase Edge Function secrets.

# --- Supabase (required) -----------------------------------------------
# Project Settings -> API. The anon key is designed to be public; your data
# is protected by row-level security, not by hiding this key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- UPI payments (required only if you sell premium) -------------------
# Your own UPI handle. Payments land directly in this account, so anyone
# self-hosting MUST change it.
EXPO_PUBLIC_FAMPAY_UPI_ID=yourname@upi
EXPO_PUBLIC_FAMPAY_NAME=Your Name

# --- Admin panel (optional) ---------------------------------------------
# Comma-separated owner emails. Must match the row seeded in
# supabase/schema.sql. Falls back to a placeholder if unset.
EXPO_PUBLIC_OWNER_EMAILS=you@example.com

# Code that reveals the hidden admin panel. This is obfuscation, not
# security — the server decides who can actually approve payments. Still,
# set your own, because the default is public in this repository.
EXPO_PUBLIC_ADMIN_CODE=change-me

# --- Update checker (optional) ------------------------------------------
# URL of latest.json (see site/). Leave empty to disable update checks.
EXPO_PUBLIC_VERSION_MANIFEST_URL=
