{
  "expo": {
    "name": "Forge",
    "slug": "forge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0d17"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "android": {
      "package": "com.forge.fitness",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b0d17"
      },
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.forge.fitness",
      "supportsTablet": false
    },
    "plugins": [
      "expo-font"
    ],
    "jsEngine": "hermes",
    "description": "An offline fitness RPG: quests, nutrition tracking, structured training and progression. No account, no cloud, no ads.",
    "primaryColor": "#5ef2ff",
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
